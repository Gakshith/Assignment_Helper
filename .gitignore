.DS_Store
.env
.env.local
node_modules/
__pycache__/
*.pyc
.venv/
dist/
build/

# never commit personal handwriting data or built fonts
samples/
fonts/personal/
*.otf
*.ttf
out/

# EXCEPTION: the M0 spike's reference hands are OFL-licensed third-party fonts,
# not the user's handwriting, and the spike is not reproducible without them.
# Their OFL.txt files sit beside them. Personal handwriting stays excluded above.
!spikes/m0/fonts/*.ttf
!spikes/m0/fonts/*.otf
